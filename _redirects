# Entra SSO redirect URI is registered with Altek as
# https://my.termac.com/auth/callback (no .html). Cloudflare Pages
# generally serves clean URLs for existing .html files automatically,
# but this rule makes it explicit and guaranteed rather than relying on
# that default -- if it ever changes, Microsoft's redirect still lands
# on the right page instead of a 404.
/auth/callback /auth/callback.html 200
